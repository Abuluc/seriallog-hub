FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/SerialLogHub.Api/SerialLogHub.Api.csproj src/SerialLogHub.Api/
RUN dotnet restore src/SerialLogHub.Api/SerialLogHub.Api.csproj

COPY src/SerialLogHub.Api/ src/SerialLogHub.Api/
RUN dotnet publish src/SerialLogHub.Api/SerialLogHub.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
RUN mkdir -p /data

ENV ASPNETCORE_URLS=http://+:8080
ENV ConnectionStrings__DefaultConnection="Data Source=/data/serialloghub.db"

COPY --from=build /app/publish .
EXPOSE 8080

ENTRYPOINT ["dotnet", "SerialLogHub.Api.dll"]
