@{
    ViewData["Title"] = "Temperature & Humidity Thresholds";
}

<div class="slh-card" style="max-width: 720px;">
    <div class="slh-card-header">
        <div class="slh-card-title">
            <i class="fa-solid fa-temperature-half"></i>
            <span>Temperature &amp; Humidity Alarm Thresholds</span>
        </div>
        <span class="slh-badge slh-badge-demo">Step 5 / 6</span>
    </div>

    <div class="slh-form-row">
        <div class="slh-form-group">
            <label for="minTemperature">Min Temperature (°C)</label>
            <input type="number" id="minTemperature" class="slh-input" value="2" />
        </div>
        <div class="slh-form-group">
            <label for="maxTemperature">Max Temperature (°C)</label>
            <input type="number" id="maxTemperature" class="slh-input" value="35" />
        </div>
    </div>

    <div class="slh-form-row">
        <div class="slh-form-group">
            <label for="minHumidity">Min Humidity (%)</label>
            <input type="number" id="minHumidity" class="slh-input" value="20" />
        </div>
        <div class="slh-form-group">
            <label for="maxHumidity">Max Humidity (%)</label>
            <input type="number" id="maxHumidity" class="slh-input" value="80" />
        </div>
    </div>

    <div class="slh-wizard-footer">
        <a href="/Settings/Formatting" class="slh-btn slh-btn-outline">&lt;- Previous</a>
        <div class="slh-toolbar">
            <button type="button" id="saveThresholdsBtn" class="slh-btn slh-btn-primary">Apply Thresholds</button>
            <a href="/Settings/Time" class="slh-btn slh-btn-outline">Next -&gt;</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("saveThresholdsBtn").addEventListener("click", function () {
            const conn = window.SerialLogHub.getConnectionCookie();
            if (!conn) { toastr.warning("Connect to a device first."); return; }

            const minTemp = document.getElementById("minTemperature").value;
            const maxTemp = document.getElementById("maxTemperature").value;
            const minHum = document.getElementById("minHumidity").value;
            const maxHum = document.getElementById("maxHumidity").value;

            $.post("/Settings/SetMM", {
                model: { SelectedPort: conn.currentPort, SelectedBaudRate: conn.currentBaud },
                mmModel: { MinTemp: minTemp, MaxTemp: maxTemp, MinHum: minHum, MaxHum: maxHum }
            }).done(res => {
                if (res.status === "success") toastr.success("Thresholds applied.");
                else toastr.warning(res.message || "Timed out.");
            }).fail(() => toastr.error("Failed to apply thresholds."));
        });
    </script>
}
