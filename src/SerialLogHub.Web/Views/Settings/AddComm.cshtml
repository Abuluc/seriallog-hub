@{
    ViewData["Title"] = "Device Description";
}

<div class="slh-card" style="max-width: 720px;">
    <div class="slh-card-header">
        <div class="slh-card-title">
            <i class="fa-solid fa-comment-dots"></i>
            <span>Device Description</span>
        </div>
        <span class="slh-badge slh-badge-demo">Step 1 / 6</span>
    </div>

    <p style="margin-bottom: 16px; color: #475569; font-size: 0.9rem;">
        Current Description: <strong id="nowcomm">Loading...</strong>
    </p>

    <div class="slh-form-group">
        <label for="commentInput">New Description (Command: <code>WLG</code>)</label>
        <input type="text" id="commentInput" class="slh-input" placeholder="e.g. COLD_ROOM_A1" />
    </div>

    <div class="slh-wizard-footer">
        <a href="/Home" class="slh-btn slh-btn-outline">&lt;- Dashboard</a>
        <div class="slh-toolbar">
            <button type="button" id="saveCommentBtn" class="slh-btn slh-btn-primary">Save</button>
            <a href="/Settings/DelayStart" class="slh-btn slh-btn-outline">Next -&gt;</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadCurrentComment() {
            const conn = window.SerialLogHub.getConnectionCookie();
            if (!conn) { document.getElementById("nowcomm").textContent = "Not connected"; return; }
            $.get("/Settings/GetComm", { SelectedPort: conn.currentPort, SelectedBaudRate: conn.currentBaud })
                .done(res => {
                    const parts = (res.responseMessage || "").split(",");
                    document.getElementById("nowcomm").textContent = parts[3] || res.responseMessage || "None";
                })
                .fail(() => { document.getElementById("nowcomm").textContent = "Unavailable"; });
        }

        document.getElementById("saveCommentBtn").addEventListener("click", function () {
            const conn = window.SerialLogHub.getConnectionCookie();
            const val = document.getElementById("commentInput").value.trim().toUpperCase();
            if (!conn || !val) { toastr.warning("Connect to a device and enter a description."); return; }

            $.post("/Settings/Settocomment", {
                model: { SelectedPort: conn.currentPort, SelectedBaudRate: conn.currentBaud },
                Comment: val
            }).done(res => {
                if (res.status === "success") {
                    toastr.success("Device description updated.");
                    loadCurrentComment();
                } else {
                    toastr.warning(res.message || "Device did not respond.");
                }
            }).fail(() => toastr.error("Failed to save description."));
        });

        document.addEventListener("DOMContentLoaded", loadCurrentComment);
    </script>
}
