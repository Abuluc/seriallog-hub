@{
    ViewData["Title"] = "Clock Calibration";
}

<div class="slh-card" style="max-width: 720px;">
    <div class="slh-card-header">
        <div class="slh-card-title">
            <i class="fa-solid fa-clock"></i>
            <span>Device RTC Clock Calibration</span>
        </div>
        <span class="slh-badge slh-badge-demo">Step 3 / 6</span>
    </div>

    <p style="margin-bottom: 18px; font-size: 1rem;">
        Current Device Time (<code>WLH0</code>): <strong id="currentDeviceTime">Reading...</strong>
    </p>

    <div class="slh-wizard-footer">
        <a href="/Settings/DelayStart" class="slh-btn slh-btn-outline">&lt;- Previous</a>
        <div class="slh-toolbar">
            <button type="button" id="calibrateBtn" class="slh-btn slh-btn-primary">Sync with System Clock (WLH1)</button>
            <a href="/Settings/Formatting" class="slh-btn slh-btn-outline">Next -&gt;</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function readDeviceTime() {
            const conn = window.SerialLogHub.getConnectionCookie();
            if (!conn) { document.getElementById("currentDeviceTime").textContent = "Not connected"; return; }
            $.post("/Settings/GetCalibrationTime", {
                model: { SelectedPort: conn.currentPort, SelectedBaudRate: conn.currentBaud }
            }).done(res => {
                const raw = res.response || "";
                const p = raw.split(",");
                if (p.length >= 9) {
                    document.getElementById("currentDeviceTime").textContent = `${p[5]}/${p[4]}/${p[3]} ${p[6]}:${p[7]}:${p[8]}`;
                } else {
                    document.getElementById("currentDeviceTime").textContent = raw || "No response";
                }
            }).fail(() => { document.getElementById("currentDeviceTime").textContent = "Error reading clock"; });
        }

        document.getElementById("calibrateBtn").addEventListener("click", function () {
            const conn = window.SerialLogHub.getConnectionCookie();
            if (!conn) { toastr.warning("Connect to a device first."); return; }
            const d = new Date();
            const formatted =
                String(d.getFullYear()).slice(2) + "-" +
                String(d.getMonth() + 1).padStart(2, "0") + "-" +
                String(d.getDate()).padStart(2, "0") + "," +
                String(d.getHours()).padStart(2, "0") + "-" +
                String(d.getMinutes()).padStart(2, "0") + "-" +
                String(d.getSeconds()).padStart(2, "0");

            $.post("/Settings/UpdateDeviceTime", {
                deviceTime: formatted,
                model: { SelectedPort: conn.currentPort, SelectedBaudRate: conn.currentBaud }
            }).done(res => {
                if (res.status === "success") {
                    toastr.success("Device clock synchronized.");
                    readDeviceTime();
                } else {
                    toastr.warning(res.message || "Timed out.");
                }
            }).fail(() => toastr.error("Clock sync failed."));
        });

        document.addEventListener("DOMContentLoaded", readDeviceTime);
    </script>
}
