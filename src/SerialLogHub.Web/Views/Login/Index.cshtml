@{
    Layout = null;
    bool demoEnabled = ViewBag.DemoModeEnabled == true;
    string demoEmail = ViewBag.DemoEmail as string ?? "demo@serialloghub.local";
    string demoUsername = ViewBag.DemoUsername as string ?? "demo_operator";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — SerialLog Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at top left, #1e3a8a, #0f172a 60%);
            color: #0f172a;
            padding: 20px;
        }
        .auth-card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
            overflow: hidden;
        }
        .auth-header {
            background: #0f172a;
            color: #ffffff;
            padding: 26px 28px;
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .auth-logo {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, #3b82f6, #06b6d4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }
        .auth-title { font-size: 1.25rem; font-weight: 700; }
        .auth-sub { font-size: 0.8rem; color: #94a3b8; }
        .auth-tabs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }
        .auth-tab {
            padding: 12px;
            border: none;
            background: transparent;
            font-weight: 600;
            font-size: 0.85rem;
            color: #64748b;
            cursor: pointer;
            border-bottom: 2px solid transparent;
        }
        .auth-tab.active {
            color: #2563eb;
            border-bottom-color: #2563eb;
            background: #ffffff;
        }
        .auth-body { padding: 24px 28px 28px; }
        .form-group { margin-bottom: 14px; }
        .form-group label { display: block; font-size: 0.8rem; font-weight: 600; color: #334155; margin-bottom: 5px; }
        .form-control {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 0.9rem;
            outline: none;
        }
        .form-control:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15); }
        .btn-primary {
            width: 100%;
            padding: 11px;
            border: none;
            border-radius: 8px;
            background: #2563eb;
            color: #ffffff;
            font-weight: 600;
            font-size: 0.92rem;
            cursor: pointer;
            margin-top: 6px;
        }
        .btn-primary:hover { background: #1d4ed8; }
        .demo-banner {
            margin-top: 16px;
            padding: 12px 14px;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 10px;
            font-size: 0.8rem;
            color: #1e40af;
        }
        .demo-banner button {
            margin-top: 8px;
            width: 100%;
            padding: 8px;
            border-radius: 6px;
            border: 1px solid #3b82f6;
            background: #ffffff;
            color: #1d4ed8;
            font-weight: 600;
            cursor: pointer;
        }
        .demo-banner button:hover { background: #dbeafe; }
        .panel { display: none; }
        .panel.active { display: block; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo"><i class="fa-solid fa-wave-square"></i></div>
            <div>
                <div class="auth-title">SerialLog Hub</div>
                <div class="auth-sub">DataLogger Configuration &amp; Telemetry Platform</div>
            </div>
        </div>

        <div class="auth-tabs">
            <button type="button" class="auth-tab active" data-target="loginPanel">Sign In</button>
            <button type="button" class="auth-tab" data-target="registerPanel">Register</button>
            <button type="button" class="auth-tab" data-target="resetPanel">Reset Password</button>
        </div>

        <div class="auth-body">
            <!-- Login -->
            <div id="loginPanel" class="panel active">
                <form id="loginFormAction">
                    <div class="form-group">
                        <label for="loginEmail">Email</label>
                        <input type="email" id="loginEmail" class="form-control" placeholder="operator@example.com" required />
                    </div>
                    <div class="form-group">
                        <label for="loginUsername">Username</label>
                        <input type="text" id="loginUsername" class="form-control" placeholder="Enter username" required />
                    </div>
                    <div class="form-group">
                        <label for="loginPassword">Password</label>
                        <input type="password" id="loginPassword" class="form-control" placeholder="Enter password" required />
                    </div>
                    <button type="submit" class="btn-primary">Sign In</button>
                </form>

                @if (demoEnabled)
                {
                    <div class="demo-banner">
                        <strong><i class="fa-solid fa-flask"></i> Demo Mode Active</strong><br />
                        Account: <code>@demoEmail</code> / <code>@demoUsername</code>
                        <button type="button" id="fillDemoBtn">Fill Demo Operator Credentials</button>
                    </div>
                }
            </div>

            <!-- Register -->
            <div id="registerPanel" class="panel">
                <form id="registerFormAction">
                    <div class="form-group">
                        <label for="regEmail">Email</label>
                        <input type="email" id="regEmail" class="form-control" placeholder="operator@example.com" required />
                    </div>
                    <div class="form-group">
                        <label for="regUsername">Username</label>
                        <input type="text" id="regUsername" class="form-control" placeholder="Choose a username" required />
                    </div>
                    <div class="form-group">
                        <label for="regPassword">Password</label>
                        <input type="password" id="regPassword" class="form-control" placeholder="Minimum 6 characters" minlength="6" required />
                    </div>
                    <button type="submit" class="btn-primary">Create Account</button>
                </form>
            </div>

            <!-- Reset Password -->
            <div id="resetPanel" class="panel">
                <form id="resetPassFormAction">
                    <div class="form-group">
                        <label for="resetEmail">Email</label>
                        <input type="email" id="resetEmail" class="form-control" placeholder="operator@example.com" required />
                    </div>
                    <button type="submit" class="btn-primary">Send Reset Link</button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script>
        document.querySelectorAll(".auth-tab").forEach(btn => {
            btn.addEventListener("click", function () {
                document.querySelectorAll(".auth-tab").forEach(b => b.classList.remove("active"));
                document.querySelectorAll(".panel").forEach(p => p.classList.remove("active"));
                this.classList.add("active");
                document.getElementById(this.dataset.target).classList.add("active");
            });
        });

        const fillBtn = document.getElementById("fillDemoBtn");
        if (fillBtn) {
            fillBtn.addEventListener("click", function () {
                document.getElementById("loginEmail").value = "@demoEmail";
                document.getElementById("loginUsername").value = "@demoUsername";
                document.getElementById("loginPassword").value = "Demo1234!";
            });
        }

        $("#loginFormAction").on("submit", function (e) {
            e.preventDefault();
            $.ajax({
                url: "/api/auth/login",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    Email: $("#loginEmail").val(),
                    Username: $("#loginUsername").val(),
                    HashedPassword: $("#loginPassword").val()
                }),
                success: function () {
                    toastr.success("Signed in successfully.");
                    window.location.href = "/Home";
                },
                error: function (xhr) {
                    const msg = xhr.responseJSON?.error || xhr.responseJSON?.Error || "Login failed.";
                    toastr.error(msg);
                }
            });
        });

        $("#registerFormAction").on("submit", function (e) {
            e.preventDefault();
            $.ajax({
                url: "/api/auth/register",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    Email: $("#regEmail").val(),
                    Username: $("#regUsername").val(),
                    HashedPassword: $("#regPassword").val()
                }),
                success: function (res) {
                    toastr.success(res.message || "Registered successfully. You can now sign in.");
                    document.querySelector('.auth-tab[data-target="loginPanel"]').click();
                },
                error: function (xhr) {
                    const msg = xhr.responseJSON?.error || xhr.responseJSON?.Error || "Registration failed.";
                    toastr.error(msg);
                }
            });
        });

        $("#resetPassFormAction").on("submit", function (e) {
            e.preventDefault();
            $.ajax({
                url: "/api/auth/reset-password",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ Email: $("#resetEmail").val() }),
                success: function (res) {
                    toastr.success(res.message || "Reset instructions sent.");
                },
                error: function (xhr) {
                    toastr.error(xhr.responseJSON?.error || "Password reset failed.");
                }
            });
        });
    </script>
</body>
</html>
