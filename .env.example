# SerialLog Hub — Environment & Configuration Example
# Copy values into appsettings.Development.json or environment variables (using __ for nested keys)

# --- SerialLogHub.Api ---
ConnectionStrings__DefaultConnection=Data Source=serialloghub.db
ApiSecurity__ApiKey=replace-with-strong-api-key
ApiSecurity__RequireApiKey=true
DemoMode__Enabled=true
DemoMode__DemoEmail=demo@serialloghub.local
DemoMode__DemoUsername=demo_operator
DemoMode__DemoPassword=ChangeMeDemo123!

# --- SerialLogHub.Web ---
ApiSettings__BaseUrl=http://localhost:8080/api/
ApiSettings__ApiKey=replace-with-strong-api-key
ApiSettings__CommandTimeoutSeconds=30
BridgeSecurity__BridgeKey=replace-with-strong-bridge-key
BridgeSecurity__RequireBridgeKey=true
DemoMode__Enabled=true

# --- SerialLogHub.Desktop (src/SerialLogHub.Desktop/appsettings.json) ---
# ApiBaseUrl=http://localhost:8080/api/
# WebBridgeBaseUrl=http://localhost:3000/
# ApiKey=replace-with-strong-api-key
# BridgeKey=replace-with-strong-bridge-key
# EnableVirtualDemoDevice=true
